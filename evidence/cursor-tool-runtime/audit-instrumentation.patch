+// applyAuditExperiments is audit-only instrumentation gated behind env vars so a
+// single build can isolate which AgentRunRequest field changes native-tool
+// selection. Not part of the shipped behaviour.
+func applyAuditExperiments(arr *dynamicpb.Message) {
+	if os.Getenv("CURSOR_EXP_MCPFS") != "" {
+		opts := newMsg("McpFileSystemOptions")
+		setBool(opts, "enabled", os.Getenv("CURSOR_EXP_MCPFS") == "1")
+		if dir := os.Getenv("CURSOR_EXP_MCPFS_DIR"); dir != "" {
+			setStr(opts, "workspace_project_dir", dir)
+		}
+		setMsg(arr, "mcp_file_system_options", opts)
+		log.Debugf("cursor-audit: set mcp_file_system_options enabled=%v", os.Getenv("CURSOR_EXP_MCPFS") == "1")
+	}
+	if sp := os.Getenv("CURSOR_EXP_SYSPROMPT"); sp != "" {
+		setStr(arr, "custom_system_prompt", sp)
+		log.Debugf("cursor-audit: set custom_system_prompt len=%d", len(sp))
+	}
+	if h := os.Getenv("CURSOR_EXP_HARNESS"); h != "" {
+		if f := arr.Descriptor().Fields().ByName("harness"); f != nil {
+			arr.Set(f, protoreflect.ValueOfString(h))
+			log.Debugf("cursor-audit: set harness=%q", h)
+		} else {
+			log.Debugf("cursor-audit: harness field absent from bundled descriptor")
+		}
+	}
+}
