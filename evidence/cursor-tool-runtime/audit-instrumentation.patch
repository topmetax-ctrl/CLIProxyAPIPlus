+// applyAuditRequestContextExperiments is audit-only instrumentation (see
+// applyAuditExperiments).
+func applyAuditRequestContextExperiments(rc *dynamicpb.Message) {
+	if os.Getenv("CURSOR_EXP_ENV") != "" {
+		env := newMsg("RequestContextEnv")
+		setStr(env, "os_version", os.Getenv("CURSOR_EXP_ENV_OS"))
+		setStr(env, "shell", os.Getenv("CURSOR_EXP_ENV_SHELL"))
+		setStr(env, "project_folder", os.Getenv("CURSOR_EXP_ENV_PROJECT"))
+		if wp := os.Getenv("CURSOR_EXP_ENV_WORKSPACE"); wp != "" {
+			f := field(env, "workspace_paths")
+			env.Mutable(f).List().Append(protoreflect.ValueOfString(wp))
+		}
+		setMsg(rc, "env", env)
+		log.Debugf("cursor-audit: set RequestContext.env")
+	}
+	if os.Getenv("CURSOR_EXP_RC_MCPFS") != "" {
+		opts := newMsg("McpFileSystemOptions")
+		setBool(opts, "enabled", os.Getenv("CURSOR_EXP_RC_MCPFS") == "1")
+		setMsg(rc, "mcp_file_system_options", opts)
+		log.Debugf("cursor-audit: set RequestContext.mcp_file_system_options")
+	}
+}
