<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cursorapi.cliproxy-audit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/macdev/Demo/CursorAPI/CLIProxyAPIPlus/cliproxy-audit</string>
        <string>--config</string>
        <string>config-cursor-audit.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/macdev/Demo/CursorAPI/CLIProxyAPIPlus</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/cliproxy-audit.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/cliproxy-audit.log</string>
</dict>
</plist>
